# Copie para .env e ajuste os valores antes de subir a stack
# cp .env.example .env

# Identificação do ambiente (local | staging | prod) — usada nos nomes dos containers
ENVIRONMENT=local

# Banco de dados (SQL Server 2022)
MSSQL_SA_PASSWORD=Ecotracker@2026
DB_NAME=EcoTracker
DB_PORT=1433

# API
API_PORT=8080
API_IMAGE=ecotracker-api:local
ASPNETCORE_ENVIRONMENT=Development
ENABLE_SWAGGER=true

# JWT (use uma chave com no mínimo 32 caracteres)
JWT_KEY=EcoTracker-SecretKey-2026-ESG-Compliance-Min32Chars!
JWT_ISSUER=EcoTracker
JWT_AUDIENCE=EcoTrackerUsers
